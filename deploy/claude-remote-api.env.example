# Install to /etc/claude-remote-api.env, owned by pigri, mode 0600.
# Required: the bearer token clients must send as `Authorization: Bearer <token>`.
CLAUDE_REMOTE_API_TOKEN=replace-with-a-long-random-token

# Optional overrides:
# Bind address (default :8080). Prefer binding to localhost behind a TLS
# reverse proxy / tunnel, since the bearer token travels in the header.
#CLAUDE_REMOTE_API_ADDR=127.0.0.1:8080

# Absolute path to the claude binary (robust regardless of PATH).
#CLAUDE_BIN=/home/pigri/.local/bin/claude

# Session name prefix (default pigri-dev-remote).
#CLAUDE_REMOTE_SESSION_PREFIX=pigri-dev-remote

# Several Claude accounts on one server, as name=dir pairs; the first is the
# default unless CLAUDE_REMOTE_DEFAULT_PROFILE names another.
#CLAUDE_REMOTE_PROFILES=work=~/.claude,private=~/.claude-private
#CLAUDE_REMOTE_DEFAULT_PROFILE=work

# Session sync (quits the screens of sessions archived in the cloud). Each
# profile signs in with its own <dir>/.credentials.json; a profile without one
# is skipped. CLAUDE_REMOTE_CREDENTIALS overrides that file with one profile
# only: with CLAUDE_REMOTE_PROFILES set, it is a startup error.
#CLAUDE_REMOTE_SESSION_SYNC=on
#CLAUDE_REMOTE_CREDENTIALS=/home/pigri/.claude/.credentials.json
